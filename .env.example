# Copie para .env.local e preencha com os dados do projeto Supabase
# (Project Settings > API). Nunca envie este arquivo preenchido ao GitHub.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de serviço: usada só no servidor (criação de contas por convite).
SUPABASE_SERVICE_ROLE_KEY=
# Endereço público do app, usado nos links de convite e redefinição de senha.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# E-mail (opcional): resumo diário de avisos via Resend. Sem estas três, nada é enviado.
RESEND_API_KEY=
EMAIL_FROM="CEOEXPRESS <nao-responda@ceoexpress.com.br>"
# Senha que a Vercel usa para chamar o resumo diário (texto longo e aleatório).
CRON_SECRET=
# IA (opcional): liga o botão "Analisar com IA" nos relatórios. Sem ela, só o relatório por regras.
ANTHROPIC_API_KEY=
